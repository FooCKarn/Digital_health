# ตัวอย่างตัวแปรสภาพแวดล้อม: คัดลอกเป็นไฟล์ .env (ไฟล์จริงถูก ignore ห้าม commit) แล้วใส่ค่าเอง
# ห้ามใส่คีย์จริงในไฟล์นี้ ไฟล์นี้ขึ้น git ได้เพราะมีแต่ชื่อตัวแปร
# ใช้เฉพาะจุดที่เรียก AI (แยกข้อความ / เรียบเรียงคำอธิบาย / แชต) ไม่มีคีย์ก็ใช้ตัวตรวจและ template สำรองได้

# คีย์ Google AI Studio (https://aistudio.google.com) สร้างใหม่ได้ทุกเครื่อง
GEMINI_API_KEY=

# ทางเลือก: ถ้าใช้ Claude แทน (ตั้ง LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
LLM_PROVIDER=

# ทางเลือก: โมเดลและเวลารอ (ค่าเริ่มต้นอยู่ใน engine/llm.py)
GEMINI_MODEL=
LLM_TIMEOUT_SEC=

# เปิดให้ LLM เรียบเรียงคำตอบแชตเมื่อเป็น 1 (ค่าเริ่มต้น: ปิด ตอบแบบสกัดข้อความจากฐานข้อมูล)
HERBGUARD_CHAT_LLM=
