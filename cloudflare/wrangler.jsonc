{
  // ใบพลู (Baiploo) บน Cloudflare: Python Worker (ตัวตรวจ + บัญชีผู้ใช้) + D1 (ข้อมูลอ้างอิง/บัญชี/ข้อมูลที่ซิงก์) + Static Assets (เว็บ)
  // deploy อัตโนมัติด้วย .github/workflows/deploy-cloudflare.yml เมื่อ push เข้า main (ต้องมี secret CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID) ด้วยมือ: รัน `python scripts/build_worker.py` (สร้าง cloudflare/build/) และสร้าง D1 ตาม cloudflare/README.md แล้วใส่ database_id
  "name": "herbguard-ttm",
  "main": "build/worker.py",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["python_workers"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "herbguard",
      "database_id": "937c34b4-5bb3-4cc8-8c32-fce4d7d70085",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // ความลับ (ไม่ใส่ในไฟล์นี้): npx wrangler secret put GEMINI_API_KEY   (หรือ ANTHROPIC_API_KEY)
  // ตัวเลือก: vars เช่น GEMINI_MODEL, GEMINI_SEARCH_MODEL, HERBGUARD_CHAT_LLM=0 (ปิด AI เรียบเรียง), HERBGUARD_WEB_SEARCH=0 (ปิดค้นภายนอก)
}
